#!/usr/bin/env bash
# Check that the commit message follows "<type>(<scope>): <subject>".
msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1)

# Let messages generated by git itself pass
if [[ "$subject" =~ ^(Merge|Revert|fixup!|squash!|amend!) ]]; then
  exit 0
fi

types="feat|fix|refactor|perf|test|bench|docs|build|chore"
pattern="^($types)(\([a-z0-9_-]+\))?!?: .+"

if [[ ! "$subject" =~ $pattern ]]; then
  echo "✗ invalid commit message format: \"$subject\"" >&2
  echo "  format:  <type>(<scope>): <subject>" >&2
  echo "  type: ${types//|/, }" >&2
  echo "  example: feat(kernels): add naive gemm kernel" >&2
  exit 1
fi

if (( ${#subject} > 72 )); then
  echo "✗ subject is longer than 72 characters (${#subject})" >&2
  exit 1
fi
